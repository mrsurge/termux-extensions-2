{
  "schemaVersion": 1,
  "appId": "te2",
  "manifestBase": "framework",
  "manifest": "rust/Cargo.toml",
  "package": "te2-server",
  "binary": "te2-server",
  "environmentKey": "TE2_SERVER_BIN",
  "pythonAbi": false,
  "features": ["ferrous-framework-native", "native-mcp"],
  "cache": {
    "root": "framework/build",
    "targetDirectory": "cargo-target",
    "targetDirectoryEnvironment": "TE2_SERVER_CARGO_TARGET_DIR",
    "publishedDirectory": "bin"
  },
  "fingerprint": {
    "policy": "framework-source-v2",
    "inputs": ["Cargo.toml", "Cargo.lock", "crates/**/Cargo.toml", "crates/**/*.rs"],
    "sharedInputs": ["../asset_gzip.rs", "../mcp_probe/fixtures/python_tools.json"]
  }
}
