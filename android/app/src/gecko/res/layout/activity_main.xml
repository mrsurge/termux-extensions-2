<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/nativeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#050C1F">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home" />

            <Button
                android:id="@+id/btnReload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reload" />

            <Button
                android:id="@+id/btnRecents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recents" />

            <Button
                android:id="@+id/btnLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lock" />

            <Button
                android:id="@+id/btnQuit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quit" />

            <Button
                android:id="@+id/btnConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️" />
        </LinearLayout>

        <com.termux.extensions.FilteredGeckoView
            android:id="@+id/geckoView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/consoleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/consolePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/consoleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnConsoleBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back" />

                <TextView
                    android:id="@+id/consoleTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Tools"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConsoleStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flush Cache" />

                <Button
                    android:id="@+id/btnUpdateTe2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update UI" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolsTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/btnToolsConsole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Console" />

                <Button
                    android:id="@+id/btnToolsInspector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Inspector" />
            </LinearLayout>

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeConsoleContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/inspectorPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#292A2D"
                android:visibility="gone">

                <org.mozilla.geckoview.GeckoView
                    android:id="@+id/inspectorGeckoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/inspectorStatus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Enable native developer tools in Android Settings."
                    android:textColor="#FFFFFF"
                    android:textIsSelectable="true" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
