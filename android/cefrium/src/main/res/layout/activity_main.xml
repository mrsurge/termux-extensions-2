<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/nativeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#050C1F"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/native_action_home" />

            <Button
                android:id="@+id/btnReload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/native_action_reload" />

            <Button
                android:id="@+id/btnRecents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/native_action_recents" />

            <Button
                android:id="@+id/btnLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/native_action_lock" />

            <Button
                android:id="@+id/btnQuit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/native_action_quit" />

            <Button
                android:id="@+id/btnConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/native_action_tools"
                android:text="@string/native_action_tools_symbol" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/browserContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/consoleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/consolePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/consoleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnConsoleBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/native_action_back" />

                <TextView
                    android:id="@+id/consoleTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Tools"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConsoleStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/native_action_flush_cache" />

                <Button
                    android:id="@+id/btnUpdateTe2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/native_action_update_ui" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolsTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/btnToolsConsole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/native_tools_console" />

                <Button
                    android:id="@+id/btnToolsInspector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/native_tools_inspector" />

                <Button
                    android:id="@+id/btnToolsProcesses"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/native_tools_processes" />
            </LinearLayout>

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeConsoleContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/inspectorPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#292A2D"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/inspectorTargetPicker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="top"
                    android:contentDescription="@string/native_tools_inspector"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <FrameLayout
                    android:id="@+id/inspectorBrowserContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="48dp">

                    <TextView
                        android:id="@+id/inspectorStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#292A2D"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="@string/cefrium_inspector_unavailable"
                        android:textColor="#FFFFFF"
                        android:textIsSelectable="true" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/processesPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#292A2D"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
