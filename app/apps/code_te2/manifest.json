{
  "name": "Code TE2",
  "id": "code_te2",
  "id_aliases": [
    "file_editor_cm6"
  ],
  "icon_src": "/apps/code_te2/static/icons/CODE_TE2.png",
  "version": "0.2.354",
  "description": "The Monaco based code editor for TE2",
  "author": "mrSurge",
  "entrypoints": {
    "backend_blueprint": "main.py",
    "frontend_template": "template.html",
    "frontend_script": "static/dist/host.js?v=0.2.354"
  },
  "shellspec": {
    "app_worker": "shellspec/app_worker.yaml#app-worker"
  },
  "services": {
    "path": "services",
    "modules": [
      "sidebar_backchannel_uds"
    ]
  },
  "sio_service": "sio_service.json",
  "readiness_support": "pipe",
  "ipc": {
    "services": {
      "sidebar": {
        "version": 1,
        "callers": ["terminal", "file_explorer", "file_editor", "als-rs"],
        "methods": ["cwd.get", "window.state.update", "file.open", "file.edit",
          "project.lookup", "project.open", "project.create", "agentEdits.publish",
          "agentEdits.clear", "agentEdits.list", "agentEdits.documentState.get",
          "agentEdits.decide", "drafts.list", "draftState.get", "draft.clear"],
        "limits": {
          "file.edit": {"requestBytes": 8388608, "replyBytes": 8388608, "timeoutMs": 60000},
          "agentEdits.publish": {"requestBytes": 8388608, "replyBytes": 8388608, "timeoutMs": 60000},
          "agentEdits.list": {"replyBytes": 8388608, "timeoutMs": 60000},
          "agentEdits.documentState.get": {"replyBytes": 8388608, "timeoutMs": 60000},
          "agentEdits.decide": {"replyBytes": 8388608, "timeoutMs": 60000},
          "drafts.list": {"replyBytes": 8388608, "timeoutMs": 60000},
          "draftState.get": {"replyBytes": 8388608, "timeoutMs": 60000},
          "draft.clear": {"replyBytes": 8388608, "timeoutMs": 60000},
          "project.open": {"timeoutMs": 180000},
          "project.create": {"timeoutMs": 180000}
        }
      }
    }
  },
  "frontend_preparation": true,
  "fullscreen": true
}
