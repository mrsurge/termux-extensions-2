{
  "typeCheckingMode": "strict",
  "reportAny": "error",
  "reportExplicitAny": "error",
  "pythonPlatform": "Linux",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "../../.."
      ]
    }
  ],
  "include": [
    "."
  ],
  "exclude": [
    "android_lang",
    "../file_editor",
    "../archive_manager",
    "../file_explorer",
    "../aria_downloader",
    "../terminal",
    "../settings",
    "../../static/vendor"
  ],
  "ignore": [
    "android_lang",
    "../file_editor",
    "../archive_manager",
    "../file_explorer",
    "../aria_downloader",
    "../terminal",
    "../settings",
    "../../static/vendor"
  ]
}
