{
  "id": "terminal",
  "name": "Terminal",
  "icon_emoji": ">_",
  "version": "0.1.0",
  "description": "Embedded terminals powered by framework shells (dtach).",
  "shellspec": {
    "app_worker": "shellspec/app_worker.yaml#app-worker"
  },
  "services": {
    "path": "services",
    "modules": [
      "terminal_transport"
    ]
  },
  "entrypoints": {
    "backend_blueprint": "backend.py",
    "frontend_template": "template.html",
    "frontend_script": "main.js"
  }
}
