{
  "private": true,
  "name": "file-editor-cm6",
  "description": "TE2 file editor frontend build",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "test:dialogs": "node --test ../../static/js/te_dialog.test.mjs ../../static/js/te_dialog_source_gate.test.mjs tests/te_dialog_dom.test.mjs tests/modal_kit.test.mjs",
    "test:extension-activation": "node --test tests/extension_activation_runtime.test.mjs",
    "test:extension-activity": "node --test tests/extension_activity_runtime.test.mjs tests/extension_activity_ui.test.mjs",
    "test:explorer-tree": "node --test tests/explorer_tree_chrome.test.mjs",
    "test:file-tabs": "node --test tests/file_tabs_controller.test.mjs",
    "test:editor-preferences": "node --test tests/editor_inlay_hints_preference.test.mjs",
    "test:run-profiles": "node --test tests/run_file.test.mjs tests/run_profiles_modal.test.mjs tests/run_target_resolver.test.mjs tests/sidebar_devtools_target.test.mjs",
    "test:code-inspector": "node --test tests/code_navigation_runtime.test.mjs tests/code_inspector_runtime.test.mjs",
    "test:marketplace": "node --test tests/explorer_marketplace.test.mjs",
    "test:mobile-input": "node --test tests/mobile_special_keys.test.mjs",
    "test:transport": "node --test tests/socketio_transport.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.5",
    "socket.io": "^4.8.3",
    "vite": "^7.2.4"
  }
}
