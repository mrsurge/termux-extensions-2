    "happy-dom": "^20.11.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "socket.io": "^4.8.3",
    "vite": "^7.2.4"
  }
