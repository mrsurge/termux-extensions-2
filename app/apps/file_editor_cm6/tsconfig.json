{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "../..",
    "baseUrl": ".",
    "outDir": "static/dist",
    "paths": {
      "/static/vendor/*": ["../../static/vendor/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "monaco_editor/**/*.ts",
    "static/js/**/*.js",
    "static/js/**/*.ts",
    "extensions/sidebar_extension/static/js/**/*.js",
    "monaco_editor/m_editor_app.js"
  ],
  "exclude": [
    "node_modules",
    "static/dist",
    "static/js/vendor",
    "static/vendor",
    "vendor"
  ]
}
