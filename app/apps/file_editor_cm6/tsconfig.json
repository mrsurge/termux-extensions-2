{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "../..",
    "baseUrl": ".",
    "outDir": "static/dist",
    "paths": {
      "/static/vendor/*": ["../../static/vendor/*"]
    }
  },
  "include": [
    "monaco_editor/**/*.d.ts",
    "monaco_editor/**/*.ts",
    "monaco_editor/m_editor_app.ts",
    "src/explorer/**/*.d.ts",
    "src/explorer/**/*.ts",
    "static/js/explorer.ts"
  ],
  "exclude": [
    "node_modules",
    "static/dist",
    "static/js/vendor",
    "static/vendor",
    "vendor",
    "monaco_editor/build_shims",
    "monaco_editor/vscode_build_src",
    "src/host"
  ]
}
