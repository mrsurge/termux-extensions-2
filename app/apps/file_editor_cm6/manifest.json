{
  "name": "Code CM6",
  "id": "file_editor_cm6",
  "icon_emoji": "\ud83d\udcd1",
  "version": "0.1.0",
  "description": "A full-page CodeMirror 6 editor running inside the NiceGUI shell.",
  "author": "mrSurge",
  "entrypoints": {
    "backend_blueprint": "main.py",
    "frontend_template": "template.html",
    "frontend_script": "main.js?v=ws_sio_1"
  },
  "shellspec": {
    "app_worker": "shellspec/app_worker.yaml#app-worker"
  },
  "services": {
    "path": "services",
    "modules": [
      "explorer_transport",
      "lsp_transport",
      "editor_transport",
      "vscode_rpc_transport"
    ]
  },
  "fullscreen": true,
  "ipc_modules": [
    "app.apps.file_editor_cm6.ipc_stack"
  ]
}
