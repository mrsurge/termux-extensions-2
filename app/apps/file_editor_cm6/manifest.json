{
  "name": "Code TE2",
  "id": "file_editor_cm6",
  "icon_src": "/apps/file_editor_cm6/static/icons/CODE_TE2.png",
  "version": "0.2.122",
  "description": "The Monaco based code editor for TE2",
  "author": "mrSurge",
  "entrypoints": {
    "backend_blueprint": "main.py",
    "frontend_template": "template.html",
    "frontend_script": "static/dist/host.js?v=0.2.122"
  },
  "shellspec": {
    "app_worker": "shellspec/app_worker.yaml#app-worker"
  },
  "services": {
    "path": "services",
    "modules": [
      "explorer_transport",
      "editor_transport",
      "terminal_transport",
      "vscode_rpc_transport",
      "vscode_api_transport",
      "ui_ipc_transport",
      "sidebar_backchannel_uds"
    ]
  },
  "fullscreen": true
}
