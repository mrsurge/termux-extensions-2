+// Serve installed assets without changing the request URL. Preserving the
+// framework origin is required for Chromium module workers and avoids exposing
+// the loopback asset server as a cross-origin redirect target.
+class LocalAssetResourceHandler : public CefResourceHandler {
+public:
+    explicit LocalAssetResourceHandler(std::string path)
+        : path_(std::move(path)), offset_(0), status_(200), mimeType_("application/octet-stream") {}
+
+    bool Open(CefRefPtr<CefRequest> request,
+              bool& handle_request,
+              CefRefPtr<CefCallback> callback) override {
+        (void)request;
+        (void)callback;
+        gchar* contents = nullptr;
+        gsize length = 0;
+        GError* error = nullptr;
+        if (g_file_get_contents(path_.c_str(), &contents, &length, &error)) {
+            data_.assign(contents, length);
+            g_free(contents);
+            mimeType_ = getMimeTypeFromUrl(path_);
+        } else {
+            status_ = 404;
+            data_ = "Not found";
+            mimeType_ = "text/plain";
+            if (error) g_error_free(error);
+        }
+        handle_request = true;
+        return true;
+    }
+
+    void GetResponseHeaders(CefRefPtr<CefResponse> response,
+                            int64_t& response_length,
+                            CefString& redirectUrl) override {
+        (void)redirectUrl;
+        response->SetStatus(status_);
+        response->SetStatusText(status_ == 200 ? "OK" : "Not Found");
+        response->SetMimeType(mimeType_);
+        CefResponse::HeaderMap headers;
+        headers.insert({"Access-Control-Allow-Origin", "*"});
+        headers.insert({"Cache-Control", "max-age=31536000, immutable"});
+        response->SetHeaderMap(headers);
+        response_length = static_cast<int64_t>(data_.size());
+    }
+
+    bool Read(void* data_out,
+              int bytes_to_read,
+              int& bytes_read,
+              CefRefPtr<CefResourceReadCallback> callback) override {
+        (void)callback;
+        bytes_read = 0;
+        if (offset_ >= data_.size()) return false;
+        const size_t amount = std::min(static_cast<size_t>(bytes_to_read), data_.size() - offset_);
+        memcpy(data_out, data_.data() + offset_, amount);
+        offset_ += amount;
+        bytes_read = static_cast<int>(amount);
+        return true;
+    }
+
+    void Cancel() override {}
+
+private:
+    std::string path_;
+    std::string data_;
+    size_t offset_;
+    int status_;
+    std::string mimeType_;
+
+    IMPLEMENT_REFCOUNTING(LocalAssetResourceHandler);
+};
