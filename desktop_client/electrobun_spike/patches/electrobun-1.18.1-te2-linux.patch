+static std::map<uint32_t, AssetRedirectConfig> g_assetRedirectConfigs;
+static std::mutex g_assetRedirectConfigsMutex;
+
+static bool resolveAssetMapping(uint32_t webviewId,
+                                const std::string& requestPath,
+                                AssetRedirectConfig& config,
+                                std::string& mappedPath) {
+    {
+        std::lock_guard<std::mutex> lock(g_assetRedirectConfigsMutex);
+        auto it = g_assetRedirectConfigs.find(webviewId);
+        if (it == g_assetRedirectConfigs.end()) return false;
+        config = it->second;
+    }
+    for (const auto& rule : config.rules) {
+        const bool matches = rule.prefix
+            ? requestPath.rfind(rule.source, 0) == 0
+            : requestPath == rule.source;
+        if (!matches) continue;
+        mappedPath = rule.prefix
+            ? rule.destination + requestPath.substr(rule.source.length())
+            : rule.destination;
+        return !mappedPath.empty() && mappedPath.front() == '/' &&
+               mappedPath.find("/../") == std::string::npos &&
+               mappedPath.compare(mappedPath.size() >= 3 ? mappedPath.size() - 3 : 0, 3, "/..") != 0;
+    }
+    return false;
+}
