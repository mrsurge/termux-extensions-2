+ELECTROBUN_EXPORT void webviewSetAssetRedirectRules(AbstractView* abstractView, const char* rulesText) {
+    if (!abstractView) return;
+    AssetRedirectConfig config;
+    std::istringstream input(rulesText ? rulesText : "");
+    std::string line;
+    while (std::getline(input, line)) {
+        size_t first = line.find('\t');
+        if (first == std::string::npos) continue;
+        std::string kind = line.substr(0, first);
+        if (kind == "base") {
+            config.baseUrl = line.substr(first + 1);
+            continue;
+        }
+        if (kind == "root") {
+            config.rootPath = line.substr(first + 1);
+            while (config.rootPath.size() > 1 && config.rootPath.back() == '/') {
+                config.rootPath.pop_back();
+            }
+            continue;
+        }
+        size_t second = line.find('\t', first + 1);
+        if (second == std::string::npos) continue;
+        config.rules.push_back({
+            kind == "prefix",
+            line.substr(first + 1, second - first - 1),
+            line.substr(second + 1),
+        });
+    }
+    std::lock_guard<std::mutex> lock(g_assetRedirectConfigsMutex);
+    if ((config.baseUrl.empty() && config.rootPath.empty()) || config.rules.empty()) {
+        g_assetRedirectConfigs.erase(abstractView->webviewId);
+    } else {
+        g_assetRedirectConfigs[abstractView->webviewId] = std::move(config);
+    }
 }
 
