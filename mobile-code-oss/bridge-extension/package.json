        {
          "id": "mobile.chatPlaceholder",
          "name": "Chat Placeholder"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ."
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/vscode": "^1.92.0"
  }
}