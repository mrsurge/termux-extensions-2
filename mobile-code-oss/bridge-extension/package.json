{
  "name": "mobile-bridge",
  "displayName": "Mobile Bridge",
  "description": "Bridges a parent mobile shell to VS Code Web commands via postMessage",
  "version": "0.0.1",
  "publisher": "you",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*"
